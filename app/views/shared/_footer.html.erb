<footer class="border-t border-white bg-purple-950 text-white">
  <div class="mx-auto w-full max-w-7xl px-6 py-8 sm:px-10 lg:px-14">
    <div class="flex flex-col gap-8 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <div class="w-full sm:w-auto sm:max-w-xs">
        <h6 class="text-sm font-semibold uppercase tracking-[0.2em] text-white"><%= @school.name || '' %> Music Department</h6>
        <p class="mt-3 text-xs text-white/80">© <%= Time.current.year %> <%= @school.name || '' %> Music Department</p>
        <p class="mt-1 text-xs text-white/80">
          Site created by
          <%= link_to 'KnownReference', 'https://knownreference.com', target: '_blank', rel: 'noopener noreferrer', class: 'font-semibold text-white transition hover:text-white/80' %>
        </p>
        <% if current_director.present? %>
          <div class="mt-3">
            <%= link_to "Sign out (#{current_director.email})", destroy_director_session_path, data: { turbo_method: :delete }, class: 'inline-flex rounded-md border border-white/30 px-3 py-2 text-xs font-semibold text-white transition hover:border-white/60 hover:bg-white/10' %>
          </div>
        <% end %>
      </div>

      <div class="w-full sm:w-auto sm:max-w-sm">
        <h6 class="text-sm font-semibold uppercase tracking-[0.2em] text-white">Explore</h6>
        <div class="mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-white/90 sm:justify-start">
          <%= link_to 'Calendar', '/#main-calendar', class: 'transition hover:text-white' %>
          <%= link_to 'Documents', amazon_pdfs_path, class: 'transition hover:text-white' %>
          <%= link_to 'Class Periods', home_about_path, class: 'transition hover:text-white' %>
          <%= link_to 'Contact', contacts_path, class: 'transition hover:text-white' %>
        </div>
      </div>

      <div class="w-full sm:w-auto sm:max-w-xs">
        <h6 class="text-sm font-semibold uppercase tracking-[0.2em] text-white">Actions</h6>
        <div class="mt-3 flex flex-wrap items-center justify-center gap-2 sm:justify-start">
          <% if donations_enabled? %>
            <%= link_to 'Donate', donations_path, class: 'inline-flex items-center justify-center rounded-md bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-purple-600' %>
          <% end %>
          <% if current_director.present? %>
            <%= link_to 'Go to Admin Dashboard', admin_root_path, class: 'inline-flex items-center justify-center rounded-md border border-white/30 px-4 py-2 text-sm font-semibold text-white transition hover:border-white/60 hover:bg-white/10' %>
          <% else %>
            <%= link_to 'Director Login', new_director_session_path, class: 'inline-flex items-center justify-center rounded-md border border-white/30 px-4 py-2 text-sm font-semibold text-white transition hover:border-white/60 hover:bg-white/10' %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</footer>