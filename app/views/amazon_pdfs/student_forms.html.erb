<div class="min-h-[90vh] px-4 py-8 md:py-12">
  <div class="mx-auto w-full max-w-6xl space-y-10">
    <div class="space-y-4">
      <% if current_director.present? %>
        <div class="flex justify-center pt-2">
          <%= link_to 'Upload New PDF / Google Doc', new_amazon_pdf_path, class: 'inline-flex items-center justify-center rounded-lg border border-white bg-purple-700 px-6 py-3 text-base font-semibold text-white shadow-lg shadow-purple-900/20 transition hover:border-emerald-600 hover:bg-emerald-600 hover:text-white' %>
        </div>
      <% end %>
    </div>

    <% if @amazon_pdfs.present? %>
      <% @amazon_pdfs.group_by { |g| g.type_of_pdf_group }.each do |group, pdfs| %>
        <section class="space-y-5 rounded-3xl border border-white/10 bg-slate-950/35 p-4 md:p-6">
          <h2 class="text-center text-2xl md:text-3xl font-bold tracking-tight text-white"><%= group.to_s.upcase %></h2>
          <div class="grid grid-cols-1 gap-5 <%= pdfs.one? ? 'lg:grid-cols-1' : 'lg:grid-cols-2' %>">
            <% pdfs.each do |pdf| %>
              <article class="<%= pdfs.one? ? 'mx-auto w-full max-w-2xl' : '' %> rounded-2xl border border-white/45 bg-gradient-to-br from-white/20 via-slate-900/85 to-slate-950/90 p-5 md:p-6 text-white shadow-xl shadow-white/25 ring-1 ring-white/20 backdrop-blur-sm">
                <div class="space-y-3">
                  <h3 class="text-xl md:text-2xl font-bold"><%= pdf.name %></h3>
                  <div>
                    <% if pdf.linked_document? %>
                      <span class="inline-flex rounded-full border border-emerald-300/40 bg-emerald-500/15 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-emerald-200">Google Doc</span>
                    <% else %>
                      <span class="inline-flex rounded-full border border-white/20 bg-white/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-white/70">PDF</span>
                    <% end %>
                  </div>
                  <p class="text-sm md:text-base leading-relaxed text-slate-200">
                    Completing this form does not mean the absence/conflict will be excused.  Verbally communicating with Ms. Barcellos and other band/guard staff members is also an expectation.  This form must be turned in as soon as you are aware of a possible conflict.                   </p>
                  <div class="flex flex-wrap gap-3 pt-2">
                    <%= link_to(pdf.linked_document? ? 'Preview Google Doc' : 'Preview PDF', pdf.url, target: '_blank', class: 'inline-flex items-center justify-center rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-sky-500') %>
                    <% if current_director.present? %>
                      <%= link_to 'Delete', amazon_pdf_path(pdf.id), data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to remove this PDF?' }, class: 'inline-flex items-center justify-center rounded-lg bg-purple-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-purple-500' %>
                    <% end %>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-dashed border-white/20 bg-slate-900/40 p-8 text-center text-slate-200">
        <p class="text-lg font-medium">No student forms are available right now.</p>
      </div>
    <% end %>
  </div>
</div>