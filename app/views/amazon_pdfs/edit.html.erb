<div class="min-h-screen px-4 py-8 md:py-12">
  <% default_source_mode = params.dig(:amazon_pdf, :source_mode).presence || (@amazon_pdf.document_url.present? ? 'link' : 'upload') %>
  <div class="mx-auto w-full max-w-4xl">
    <div class="mb-6 md:mb-8">
      <h3 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white">Edit PDF</h3>
      <p class="mt-2 text-sm md:text-base text-slate-200/90">Update the title, category, date, or switch between an uploaded file and a linked Google Doc.</p>
    </div>

    <%= simple_form_for @amazon_pdf, html: { multipart: true, class: "rounded-2xl border border-white/25 bg-slate-900/55 shadow-2xl backdrop-blur-sm p-5 md:p-8 text-white space-y-6", autocomplete: 'off' } do |form| %>
      <div x-data="{
        sourceType: '<%= default_source_mode %>',
        selectedFileName: '',
        setSource(type) {
          this.sourceType = type;
          if (type === 'link') {
            this.selectedFileName = '';
            if (this.$refs.pdfInput) this.$refs.pdfInput.value = '';
          }
          if (this.$refs.sourceMode) this.$refs.sourceMode.value = type;
        },
        setFiles(files) {
          if (!files || !files.length) return;
          this.$refs.pdfInput.files = files;
          this.selectedFileName = files[0].name;
        },
        handleDrop(event) {
          this.setFiles(event.dataTransfer.files);
        }
      }">
        <%= hidden_field_tag 'amazon_pdf[source_mode]', default_source_mode, 'x-ref': 'sourceMode' %>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <button
            type="button"
            @click="setSource('upload')"
            :class="sourceType === 'upload' ? 'border-purple-500 bg-purple-600 text-white' : 'border-white/20 bg-white/10 text-white/80 hover:bg-white/15'"
            class="rounded-xl border px-4 py-3 text-sm font-semibold transition"
          >
            Upload PDF
          </button>
          <button
            type="button"
            @click="setSource('link')"
            :class="sourceType === 'link' ? 'border-emerald-500 bg-emerald-600 text-white' : 'border-white/20 bg-white/10 text-white/80 hover:bg-white/15'"
            class="rounded-xl border px-4 py-3 text-sm font-semibold transition"
          >
            Link Google Doc
          </button>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <%= form.label :name, 'PDF Name', class: "block text-sm font-semibold uppercase tracking-wide text-slate-100 mb-2" %>
            <%= form.input :name, label: false, error: false, input_html: { class: "w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-800 placeholder-slate-400 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/30" } %>
          </div>

          <div>
            <%= form.label :programs, 'Who is this PDF for?', class: "block text-sm font-semibold uppercase tracking-wide text-slate-100 mb-2" %>
            <%= form.collection_select :program_id, @school.programs.all.order(:name), :id, :short_name, { include_blank: '--All Programs--' }, { class: 'w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-800 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/30' } %>
          </div>
        </div>

        <div>
          <%= form.label :programs, 'What type of PDF?', class: "block text-sm font-semibold uppercase tracking-wide text-slate-100 mb-2" %>
          <%= form.input :type_of_pdf_group, collection: ['Itinerary', 'Syllabus', 'Student Forms', 'Department Handbook', '3rd Party Transportation', 'Schedules', 'Other'], include_blank: '---- None Selected ---', label: false, input_html: { class: "w-full md:w-2/3 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-800 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/30" } %>
        </div>

        <div x-show="sourceType === 'upload'" x-cloak>
          <%= form.label :pdf, 'Select PDF File', class: 'block text-sm font-semibold uppercase tracking-wide text-slate-100 mb-2' %>
          <div class="rounded-xl border-2 border-dashed border-white/80 bg-white/95 p-4 md:p-5 transition text-center">
            <div class="flex flex-col items-center justify-center gap-3 text-center">
              <div>
                <p class="text-sm font-semibold text-purple-700">Choose a replacement PDF</p>
                <p class="text-xs text-purple-700/90">Leave this empty if you want to keep the current file.</p>
              </div>
              <%= form.file_field :pdf,
                accept: 'application/pdf',
                id: 'amazon_pdf_pdf_edit',
                class: 'hidden',
                'x-ref': 'pdfInput',
                '@change': "selectedFileName = $event.target.files?.[0]?.name || ''"
              %>
              <label for="amazon_pdf_pdf_edit" class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-purple-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-400/70">Choose File</label>
              <p class="text-xs font-medium text-purple-700" x-text="selectedFileName || 'No new file chosen'"></p>
            </div>
          </div>
        </div>

        <div x-show="sourceType === 'link'" x-cloak>
          <%= form.label :document_url, 'Google Doc URL', class: 'block text-sm font-semibold uppercase tracking-wide text-slate-100 mb-2' %>
          <%= form.url_field :document_url,
            placeholder: 'https://docs.google.com/...',
            class: 'w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-800 shadow-sm focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30' %>
          <p class="mt-2 text-xs text-slate-200/90">This link will be used instead of an uploaded PDF.</p>
        </div>

        <div>
          <%= form.label :event_date, 'Event Date', class: 'block text-sm font-semibold uppercase tracking-wide text-slate-100 mb-2' %>
          <%= form.date_field :event_date, class: 'w-full md:w-auto min-w-[13rem] rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-800 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/30' %>
        </div>

        <div class="flex justify-center gap-3 pt-2 text-white">
          <%= link_to 'Back', amazon_pdfs_path, class: 'rounded-lg bg-gray-500 px-4 py-2 font-bold text-white transition hover:bg-gray-700' %>
          <%= form.button :submit, 'Update Document', class: 'rounded-lg bg-blue-500 px-4 py-2 font-bold text-white transition hover:bg-blue-700' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
