  <section class="w-full bg-black px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto w-full max-w-7xl">

    <div class="mb-10 text-center sm:mb-14">
      <h2 class="section-title text-white">Band Periods</h2>
      <% if @school.about.present? %>
        <p class="section-subtitle mx-auto mt-4 max-w-3xl text-white/75"><%= @school.about %></p>
      <% end %>
    </div>

    <div>
      <% @school.programs.order(:period).each_with_index do |program, i| %>
        <% unless i.zero? %>
          <hr class="my-6 border-0 border-t-2 border-purple-300 lg:my-8" />
        <% end %>
        <article class="py-6 lg:py-8">
          <div class="flex flex-col gap-6 sm:flex-row sm:gap-8 lg:gap-10">
            <div class="relative h-56 w-full shrink-0 overflow-hidden sm:h-64 sm:w-64 lg:h-72 lg:w-72">
            <%= image_tag(
              resolve_image_src(
                program.main_gallery_image_url&.strip.presence,
                fallback: @school.default_image.to_s.strip.presence || 'default-hero.jpg'
              ),
              alt: program.description,
              class: 'h-full w-full object-cover'
            ) %>
          </div>

            <div class="flex flex-1 flex-col justify-center gap-3">
            <div>
              <div class="mb-3 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full bg-purple-500/90 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-black">
                  Period <%= program.period %>
                </span>
                <span class="inline-flex items-center rounded-full bg-white/70 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-black/80">
                  <%= program.description %>
                </span>
              </div>

              <h3 class="text-2xl font-bold text-white sm:text-3xl"><%= program.hero_title %></h3>

              <% if program.detailed_description.present? %>
                <p class="mt-3 text-sm leading-relaxed text-white/80 sm:text-base"><%= program.detailed_description %></p>
              <% end %>
            </div>

            </div>
          </div>
        </article>
      <% end %>
    </div>

  </div>
</section>