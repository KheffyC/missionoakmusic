<section class="w-full bg-neutral-950 px-4 pt-16 pb-0 sm:px-6 sm:pt-20 sm:pb-0 lg:px-8 lg:pt-24 lg:pb-0">
  <% if programs.present? %>
    <div class="mx-auto mb-6 w-[94%] text-center sm:mb-8 sm:w-[90%] lg:w-[80%]">
      <h2 class="section-title text-white">Learn About Our Programs</h2>
      <p class="section-subtitle text-white/70">See Class Schedule to read more details</p>
      <div class="mt-5">
        <%= link_to 'View Class Schedule', home_about_path, class: 'inline-flex items-center rounded-lg border border-white bg-purple-700 px-6 py-2 text-sm font-semibold text-white transition hover:bg-purple-800' %>
      </div>
    </div>

    <% program_list = programs.to_a %>
    <% if program_list.size == 7 %>
      <% [program_list.first(4), program_list.drop(4)].each_with_index do |row_programs, row_index| %>
        <div class="mx-auto grid w-[94%] grid-cols-1 gap-4 sm:w-[90%] sm:grid-cols-2 lg:gap-6 <%= row_index.zero? ? 'lg:w-[80%] lg:grid-cols-4' : 'lg:w-[60%] lg:grid-cols-3' %> <%= row_index.zero? ? '' : 'mt-6' %>">
          <% row_programs.each do |program| %>
              <article class="relative overflow-hidden rounded-2xl bg-black shadow-[0_14px_30px_rgba(0,0,0,0.35)]">
                <div class="aspect-[4/5] w-full overflow-hidden sm:aspect-[3/4] lg:aspect-[5/4]">
                  <%= image_tag(
                    resolve_image_src(
                      program.main_gallery_image_url&.strip.presence,
                      fallback: @school.default_image.to_s.strip.presence || 'default-hero.jpg'
                    ),
                    class: 'h-full w-full object-cover'
                  ) %>
                </div>

                <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent"></div>

                <div class="absolute inset-x-0 bottom-0 z-10 p-4 sm:p-5">
                  <span class="inline-flex rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-900">
                    <%= program.description %>
                  </span>
                  <h3 class="mt-2 text-xl font-semibold text-white sm:text-2xl"><%= program.hero_title %></h3>
                </div>
              </article>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="mx-auto grid w-[94%] grid-cols-1 gap-4 sm:w-[90%] sm:grid-cols-2 lg:w-[80%] lg:grid-cols-6 lg:gap-6">
        <% program_list.each do |program| %>
            <article class="relative overflow-hidden rounded-2xl bg-black shadow-[0_14px_30px_rgba(0,0,0,0.35)]">
              <div class="aspect-[4/5] w-full overflow-hidden sm:aspect-[3/4] lg:aspect-[5/4]">
                <%= image_tag(
                  resolve_image_src(
                    program.main_gallery_image_url&.strip.presence,
                    fallback: @school.default_image.to_s.strip.presence || 'default-hero.jpg'
                  ),
                  class: 'h-full w-full object-cover'
                ) %>
              </div>

              <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent"></div>

              <div class="absolute inset-x-0 bottom-0 z-10 p-4 sm:p-5">
                <span class="inline-flex rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.18em] text-gray-900">
                  <%= program.description %>
                </span>
                <h3 class="mt-2 text-xl font-semibold text-white sm:text-2xl"><%= program.hero_title %></h3>
              </div>
            </article>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <h6 class="m-5 text-center text-2xl font-bold text-white">Programs coming soon!</h6>
  <% end %>
</section>